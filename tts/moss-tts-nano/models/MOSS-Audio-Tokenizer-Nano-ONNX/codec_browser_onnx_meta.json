  "onnx": {
    "opset": 17,
    "encode_input_names": [
      "waveform",
      "input_lengths"
    ],
    "encode_output_names": [
      "audio_codes",
      "audio_code_lengths"
    ],
    "decode_input_names": [
      "audio_codes",
      "audio_code_lengths"
    ],
    "decode_output_names": [
      "audio",
      "audio_lengths"
    ]
  }
}
