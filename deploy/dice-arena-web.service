[Unit]
Description=SpaceMIT K3 Dice Arena web frontend
Wants=dice-arena-tts.service
After=network.target dice-arena-tts.service

[Service]
Type=simple
User=spacemit
WorkingDirectory=/home/spacemit/projects/dice-game/main
EnvironmentFile=-/home/spacemit/projects/dice-game/main/.dice-arena.env
ExecStart=/usr/bin/python3 backend/server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
