[Unit]
Description=SpaceMIT K3 Dice Arena web frontend
After=network.target

[Service]
Type=simple
User=spacemit
WorkingDirectory=%h/projects/dice-game/main
EnvironmentFile=-%h/projects/dice-game/main/.dice-arena.env
ExecStart=%h/projects/dice-game/main/scripts/start_web.sh
ExecStop=%h/projects/dice-game/main/scripts/stop_web.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
