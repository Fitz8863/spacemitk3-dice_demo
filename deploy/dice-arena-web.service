[Unit]
Description=SpaceMIT K3 Dice Arena web frontend
After=network.target

[Service]
Type=simple
User=spacemit
WorkingDirectory=%h/projects/dice-game/main
EnvironmentFile=-%h/projects/dice-game/main/.dice-arena.env
ExecStartPre=-python3 backend/componentctl.py start-selected tts --game dice
ExecStart=python3 backend/server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
