{
  "id": "rps",
  "name": "猜拳",
  "icon": "✊",
  "description": "石头 · 剪刀 · 布",
  "enabled": true,
  "providers": {
    "vision_adjudicator": "vision_yolov10_objdetect"
  },
  "vision_profile": {
    "schema_version": 1,
    "game_id": "rps",
    "runtime_config": "backend/games/rps/adjudicator_config.json",
    "vision": {
      "class_map": {
        "0": "布",
        "1": "石头",
        "2": "剪刀"
      },
      "participants": ["LEFT", "RIGHT"]
    },
    "multi_view": {
      "enabled": true,
      "min_views": 1
    },
    "llm": {
      "enabled": false,
      "context_mode": "single_turn_no_history",
      "timeout_seconds": 10,
      "system_prompt": "You are a strict rock-paper-scissors judge. Use only the supplied image. Reply with exactly one JSON object whose winner is LEFT, RIGHT, or TIE.",
      "user_prompt_template": "Inspect the supplied stable frame and determine the player's gesture. Return {\"winner\":\"LEFT|RIGHT|TIE\"}.",
      "allowed_outcomes": ["LEFT", "RIGHT", "TIE"]
    },
    "video": {
      "enabled": false,
      "path": "/rps/det"
    },
    "lifecycle": {
      "pre_adjudication_wait_seconds": 0,
      "post_result_hold_seconds": 2
    },
    "timeouts": {
      "yolo_detection_seconds": 6,
      "adjudication_seconds": 15
    }
  },
  "asr": {
    "phrases": {
      "confirm": ["确认", "确定", "OK", "明白了", "准备好了", "yes", "confirm", "got it", "start"],
      "repeat": ["重复", "再来一遍", "再听一次", "repeat", "again", "say it again", "one more time"],
      "new_round": ["再来一局", "再来一句", "下一局", "next round", "play again", "new round", "one more round", "one more game"],
      "retry": ["重试", "重新", "重新来一遍", "retry", "try again"],
      "back": ["返回", "退出", "back", "go back", "exit", "quit"]
    }
  },
  "state_machine": {
    "schema_version": 1,
    "initial": "rules",
    "states": {
      "rules": {
        "ui": {"view": "rules", "title": "先记住胜负小口诀", "copy": "听完后按绿色按钮出发；蓝色按钮可以再听一次，红色按钮返回。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "欢迎来到石头剪刀布。双方听口令出拳，念到布时同时亮出手势：石头赢剪刀，剪刀赢布，布赢石头，相同的手势是平局。明白了就请按绿色按钮开始。"}
        ],
        "on_intent": {
          "confirm": {"to": "play"},
          "repeat": {
            "actions": [
              {"action": "speech", "mode": "tts_local", "text": " 欢迎来到石头剪刀布。双方听口令出拳，念到布时同时亮出手势：石头赢剪刀，剪刀赢布，布赢石头，相同的手势是平局。明白了就请按绿色按钮开始。"}
            ]
          },
          "back": {"exit": true}
        }
      },
      "play": {
        "ui": {"view": "play", "title": "石头、剪刀、布——亮相！", "copy": "听到「布」时，和小搭子同时亮出手势。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "石头，剪刀，布。", "await": true}
        ],
        "duration": 0.4,
        "on_expire": {"to": "analysis"}
      },
      "analysis": {
        "ui": {"view": "analysis", "title": "手势侦探正在判断", "copy": "请保持手势不动，结果马上揭晓。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "正在判定胜负"},
          {"action": "adjudicate"}
        ],
        "on_event": {
          "adjudication.result": {"to": "result"},
          "adjudication.diagnosis": {"to": "analysis_failed"}
        }
      },
      "analysis_failed": {
        "ui": {"view": "analysis", "title": "这次没看清，再给我一次机会", "copy": "按蓝色按钮重新识别。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "本次识别未完成，可选择按蓝色按钮重新识别。"}
        ],
        "on_intent": {
          "retry": {"to": "analysis"},
          "new_round": {"to": "play"},
          "back": {"exit": true}
        }
      },
      "result": {
        "ui": {"view": "result", "title": "胜负揭晓！", "copy": ""},
        "on_enter": [
          {
            "action": "speech",
            "select_by": "winner_role",
            "cases": {
              "PLAYER": {"mode": "tts_local", "text": "你出了{player_choice}，Agent出了{agent_choice}，恭喜你赢了，要不再来一局？"},
              "AGENT": {"mode": "tts_local", "text": "你出了{player_choice}，Agent出了{agent_choice}，很遗憾你输了，要不再来一局？"},
              "TIE": {"mode": "tts_local", "text": "双方都出了{player_choice}，本局平局，再来一局？"}
            }
          }
        ],
        "on_intent": {
          "new_round": {"to": "play"},
          "back": {"exit": true}
        }
      }
    }
  }
}
