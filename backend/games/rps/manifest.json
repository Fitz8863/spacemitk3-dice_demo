  "providers": {
    "tts_local": "tts_qwen3"
  },
  "vision_profile": {
    "schema_version": 1,
    "game_id": "rps",
    "vision": {
      "model": "vision/yolov8_adjudicator/models/best.q.onnx",
      "class_map": {"0": "rock", "1": "scissors", "2": "paper"},
