{
  "id": "rps",
  "name": "猜拳",
  "icon": "✊",
  "description": "石头 · 剪刀 · 布",
  "enabled": true,
  "providers": {
    "vision_adjudicator": "vision_yolov10_objdetect",
    "robot_arm": "robot_arm_nero"
  },
  "vision_profile": {
    "schema_version": 1,
    "game_id": "rps",
    "runtime_config": "backend/games/rps/adjudicator_config.json",
    "vision": {
      "class_map": {
        "0": "布",
        "1": "石头",
        "2": "剪刀"
      },
      "participants": ["LEFT", "RIGHT"]
    },
    "multi_view": {
      "enabled": true,
      "min_views": 1
    },
    "video": {
      "enabled": true,
      "path": "/rps/det"
    },
    "lifecycle": {
      "pre_adjudication_wait_seconds": 0,
      "post_result_hold_seconds": 0
    },
    "timeouts": {
      "yolo_detection_seconds": 6,
      "adjudication_seconds": 15
    }
  },
  "asr": {
    "phrases": {
      "confirm": ["确认", "确定", "OK", "明白了", "准备好了", "yes", "confirm", "got it", "start"],
      "repeat": ["重复", "再来一遍", "再听一次", "repeat", "again", "say it again", "one more time"],
      "new_round": ["再来一局", "再来一句", "下一局", "next round", "play again", "new round", "one more round", "one more game"],
      "back": ["返回", "退出", "back", "go back", "exit", "quit"]
    }
  },
  "state_machine": {
    "schema_version": 1,
    "initial": "rules",
    "states": {
      "rules": {
        "ui": {"view": "rules", "title": "先记住胜负小口诀", "copy": "听完后按绿色按钮出发；蓝色按钮可以再听一次，红色按钮返回。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "欢迎来到石头剪刀布游戏，双方听口令出拳，按绿色按钮马上开始。"}
        ],
        "on_intent": {
          "confirm": {"to": "preparing"},
          "repeat": {
            "actions": [
              {"action": "speech", "mode": "tts_local", "text": "欢迎来到石头剪刀布游戏，双方听口令出拳，按绿色按钮马上开始。"}
            ]
          },
          "back": {"exit": true}
        }
      },
      "preparing": {
        "ui": {"view": "play", "title": "准备出拳", "copy": "小搭子正在就位，听到「布」再亮手势。"},
        "on_enter": [{"action": "robot", "command": "prepare_throw", "timeout_seconds": 30}],
        "on_event": {
          "robot.prepare_throw.completed": {"to": "play"},
          "robot.prepare_throw.failed": {"to": "analysis"}
        },
        "on_intent": {"back": {"exit": true}}
      },
      "play": {
        "ui": {"view": "play", "title": "石头、剪刀、布——亮相！", "copy": "听到「布」时，和小搭子同时亮出手势。"},
        "on_enter": [
          {"action": "speech", "mode": "audio", "text": "石头，剪刀，布。", "audio": "audio/石头剪刀布.wav", "await": true,
           "playback_seconds": 2.64,
           "on_start": [{"action": "robot", "command": "throw_gesture", "timeout_seconds": 10, "delay_seconds": 1.50, "prepared": true}]}
        ],
        "duration": 0.1,
        "on_expire": {"to": "analysis"}
      },
      "analysis": {
        "ui": {"view": "analysis", "title": "手势侦探正在判断", "copy": "请保持手势不动，结果马上揭晓。"},
        "on_enter": [
          {"action": "adjudicate"}
        ],
        "on_event": {
          "adjudication.result": {"to": "result"},
          "adjudication.diagnosis": {"to": "analysis_failed"}
        }
      },
      "analysis_failed": {
        "ui": {"view": "analysis", "title": "这局没完成，再来一次", "copy": "按绿色按钮再来一局。"},
        "on_enter": [
          {"action": "speech", "mode": "tts_local", "text": "本次判定未完成，可选择按绿色按钮再来一局。"},
          {"action": "robot", "command": "reset_home"}
        ],
        "on_intent": {
          "new_round": {"to": "preparing"},
          "back": {"exit": true}
        }
      },
      "result": {
        "ui": {"view": "result", "title": "胜负揭晓！", "copy": ""},
        "on_enter": [
          {
            "action": "speech",
            "select_by": "winner_role",
            "cases": {
              "PLAYER": {"mode": "tts_local", "text": "你出了{player_choice}，Agent出了{agent_choice}，恭喜你赢了，你真的太强了。"},
              "AGENT": {"mode": "tts_local", "text": "你出了{player_choice}，Agent出了{agent_choice}，很遗憾你输了哦，回家再练练吧。"},
              "TIE": {"mode": "tts_local", "text": "双方都出了{player_choice}，本局平局，要不再来一局？"}
            }
          },
          {"action": "robot", "command": "reset_home"}
        ],
        "on_intent": {
          "new_round": {"to": "preparing"},
          "back": {"exit": true}
        }
      }
    }
  }
}
