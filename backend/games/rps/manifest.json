      "relations": {"rock": "scissors", "scissors": "paper", "paper": "rock"},
      "tie_value": "TIE"
    },
    "llm": {
      "enabled": true,
      "transport": "openai_compatible",
      "input_mode": "stable_frame_and_prompt",
      "image_source": "stable_frame",
      "context_mode": "single_turn_no_history",
      "timeout_seconds": 3,
      "system_prompt": "You are a strict rock-paper-scissors judge. Use only the supplied image. Reply with exactly one JSON object whose winner is LEFT, RIGHT, or TIE.",
      "user_prompt_template": "Inspect the supplied stable frame, identify both players' gestures, and return {\"winner\":\"LEFT|RIGHT|TIE\"}.",
      "allowed_outcomes": ["LEFT", "RIGHT", "TIE"]
    },
    "video": {"enabled": true, "protocol": "webrtc", "path": "/rps/", "autoplay": true, "muted": true},
    "lifecycle": {"post_result_hold_seconds": 3},
    "timeouts": {"adjudication_seconds": 120}
  }
